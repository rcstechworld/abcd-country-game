body.modal-open{overflow:hidden}
.country-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:20px;z-index:1000}
.country-modal.show{display:flex}
.country-modal-backdrop{position:absolute;inset:0;background:rgba(15,35,55,.58);backdrop-filter:blur(3px)}
.country-modal-card{position:relative;z-index:1001;width:min(560px,94vw);max-height:92vh;overflow:auto;background:#fff;border-radius:32px;padding:32px 24px 26px;text-align:center;box-shadow:0 25px 70px rgba(0,0,0,.3);animation:modalIn .18s ease-out}
@keyframes modalIn{from{transform:scale(.88);opacity:0}to{transform:scale(1);opacity:1}}
.modal-close{position:absolute;right:14px;top:12px;width:44px;height:44px;border-radius:50%;background:#eef6ff;color:#17324d;font-size:22px;padding:0}
.modal-flag-img{display:block;width:min(250px,70vw);height:auto;max-height:165px;object-fit:cover;border-radius:14px;margin:8px auto 16px;box-shadow:0 5px 18px #0003}
.country-modal-card h2{font-size:42px;margin:5px 0 10px;color:#17324d}
.modal-capital-label{font-size:20px;color:#718096;margin:0 0 4px}
.modal-capital{font-size:30px;font-weight:800;color:#2563eb;margin-bottom:20px}
.modal-actions{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap}
.modal-listen{margin:0;background:#2563eb;color:#fff;min-width:120px}
