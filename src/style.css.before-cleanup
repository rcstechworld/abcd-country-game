/* ===== FINAL COUNTRY EXPLORER MODAL LAYOUT ===== */

#modalExtraInfo {
    order: 7 !important;
    width: 100%;
    margin-top: 14px;
    text-align: left;
    box-sizing: border-box;
}

/* Information cards */
#modalExtraInfo .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    margin: 14px 0;
}

#modalExtraInfo .info-item {
    background: #f7faff;
    border: 1px solid #dce7f7;
    border-radius: 14px;
    padding: 12px;
    box-sizing: border-box;
}

#modalExtraInfo .info-item span {
    display: block;
    font-size: 13px;
    color: #64748b;
    margin-bottom: 5px;
}

#modalExtraInfo .info-item strong {
    display: block;
    color: #17324d;
    font-size: 16px;
    line-height: 1.3;
}

/* States / Provinces */
#modalExtraInfo .subdivision-section {
    width: 100%;
    margin-top: 16px;
}

#modalExtraInfo .section-title {
    color: #17324d;
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 10px;
}

#modalExtraInfo .subdivision-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    max-height: 280px;
    overflow-y: auto;
    padding: 2px;
}

#modalExtraInfo .subdivision-card {
    width: 100%;
    border: 1px solid #dce7f7;
    background: #ffffff;
    border-radius: 12px;
    padding: 11px;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
}

#modalExtraInfo .subdivision-name {
    display: block;
    font-weight: 800;
    color: #17324d;
}

#modalExtraInfo .subdivision-capital,
#modalExtraInfo .subdivision-leader {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: #64748b;
}

/* Pending information */
#modalExtraInfo .data-note {
    margin-top: 14px;
    padding: 12px;
    border-radius: 12px;
    background: #fff8e8;
    border: 1px solid #f2dfad;
    color: #725b20;
    font-size: 14px;
    line-height: 1.4;
}

/* Wikipedia button - ALWAYS LAST */
#modalExtraInfo .explorer-actions {
    order: 99;
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
}

#modalExtraInfo .more-info-btn {
    width: min(100%, 360px);
    min-height: 48px;
    border: 0;
    border-radius: 14px;
    background: #eef4ff;
    color: #1d4ed8;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease;
}

#modalExtraInfo .more-info-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(37, 99, 235, .16);
}

/* State detail */
#modalExtraInfo .state-detail {
    width: 100%;
}

#modalExtraInfo .state-detail h3 {
    color: #17324d;
    font-size: 24px;
    margin: 5px 0 12px;
}

#modalExtraInfo .back-info-btn {
    border: 0;
    border-radius: 10px;
    padding: 9px 13px;
    background: #f2f4f7;
    color: #334155;
    font-weight: 700;
    cursor: pointer;
}

/* Mobile */
@media (max-width: 600px) {

    #modalExtraInfo .info-grid,
    #modalExtraInfo .subdivision-list {
        grid-template-columns: 1fr;
    }

    #modalExtraInfo .subdivision-list {
        max-height: 250px;
    }

    #modalExtraInfo .more-info-btn {
        width: 100%;
    }
}


/* Country Explorer - subdivision overview */
.subdivision-summary {
    margin-top: 16px;
}

.subdivision-count {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 7px;
    margin: 10px 0 14px;
    color: #5b6b83;
}

.subdivision-count strong {
    font-size: 30px;
    color: #2563eb;
}

.view-subdivisions-btn {
    width: 100%;
    border: 0;
    border-radius: 14px;
    padding: 13px 16px;
    background: #2563eb;
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease;
}

.view-subdivisions-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(37, 99, 235, .25);
}

.subdivision-detail-list {
    width: 100%;
}

.subdivision-page-title {
    text-align: center;
    margin: 5px 0 15px;
    color: #17324d;
}

.subdivision-full-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
    max-height: 430px;
