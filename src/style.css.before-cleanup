    padding: 3px;
}

.subdivision-full-list .subdivision-card {
    width: 100%;
}

.subdivision-full-list .subdivision-leader {
    color: #2563eb;
    font-weight: 700;
}

@media (max-width: 600px) {
    .subdivision-full-list {
        grid-template-columns: 1fr;
        max-height: 400px;
    }
}

