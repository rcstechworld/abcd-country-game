 .country-modal-card{padding:28px 15px 22px}
 .country-modal-card h2{font-size:32px}
 .modal-capital{font-size:25px}
 .modal-flag-img{width:220px}
 .modal-actions .nav-btn,.modal-listen{min-width:110px}
}

#modalFlag{cursor:pointer;display:inline-block;padding:6px;border-radius:18px}
#modalFlag:hover .modal-flag-img{transform:scale(1.04)}
#modalFlag:active .modal-flag-img{transform:scale(.97)}
#modalFlag .modal-flag-img{transition:transform .15s}

/* v10: modal controls must always receive mouse/touch clicks */
.country-modal{pointer-events:auto!important}
.country-modal-backdrop{pointer-events:auto!important}
.country-modal-card{pointer-events:auto!important}
.modal-close,.modal-actions button,#modalFlag{position:relative;z-index:1005;pointer-events:auto!important;touch-action:manipulation}
.modal-close{cursor:pointer!important}
.modal-actions button{cursor:pointer!important}
#modalFlag{cursor:pointer!important}

/* v11 modal layout/control fix */
.country-modal-card{position:relative;display:flex;flex-direction:column;align-items:center}
.modal-close{
  position:absolute!important;
  top:16px!important;
  right:16px!important;
  left:auto!important;
  margin:0!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  width:48px!important;
  height:48px!important;
  padding:0!important;
  z-index:1100!important;
}
#modalFlag{order:1}
#modalCountryName{order:2}
.modal-capital-label{order:3}
#modalCapital{order:4}
.modal-actions{order:5;width:100%}
#modalCount{order:6}

